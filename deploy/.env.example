# ── ai-bid 部署环境变量模板 ──
# 复制为 .env：cp .env.example .env，然后务必改掉带「请改成」的值。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ── 对外端口（多项目部署时，改这里避免和 A/B/C 其他项目冲突）──
FRONTEND_PORT=8080
MYSQL_PORT=3306

# ── MySQL ──
MYSQL_ROOT_PASSWORD=请改成强密码
MYSQL_USER=root
MYSQL_DATABASE=smart_tender_system

# ── JWT 密钥（Java 后端，改成随机长字符串，可 `openssl rand -hex 32` 生成）──
ST_JWT_SECRET=请改成随机长字符串

# ── 初始管理员密码（仅新装首次建号时使用；改库后以库内为准）──
AIBID_BOOTSTRAP_ADMIN_PASSWORD=请改成强密码

# ── Java ↔ Rust 内部签名密钥（两边必须完全一致）──
RUST_API_INTERNAL_SECRET=请改成随机长字符串

# ── Rust 审核总超时（分钟），大标书可调大；默认 60 ──
# 注意：RUST_REVIEW_TIMEOUT_MINUTES 只控制 Java 侧轮询等待 Rust 出结果的时长，
# Java 等待 Rust 返回的整体超时（分钟）
RUST_REVIEW_TIMEOUT_MINUTES=60
# Rust 审核管线硬上限（分钟），默认 60；到点会跳过「证据核验」并输出未验证结果，
# 结果会标记为 partial_failed。
AIBID_PIPELINE_TIMEOUT_MINUTES=60
# 证据核验多组并行度（默认 6），调大可加速、调小可避免 LLM 限流
AIBID_EVIDENCE_VERIFY_CONCURRENCY=6
# 主分析 Token 预算上限（输入+输出，默认 2.5M）：撞上限时各 Agent 优雅交卷（审到哪算哪），
# 而不是被 Execute 超时 abort 后丢弃已完成的发现。证据核验(NLI)不占此预算。
AIBID_BUDGET_TOTAL_TOKENS=2500000
# Execute 阶段超时（分钟，默认 30）。193 条款标书完整执行约 17 分钟，20 分钟曾骑在
# 边界上导致超时 abort 丢弃在途发现；条款级流式落库保证即使超时也只丢少量条款。
AIBID_EXECUTE_TIMEOUT_MINUTES=30

# ── LLM（Rust 引擎）──
AIBID_LLM_PROTOCOL=dashscope
DASHSCOPE_API_KEY=sk-你的dashscope密钥
DASHSCOPE_MODEL=qwen-turbo
# 若用 OpenAI 兼容协议（MaaS 等），改 AIBID_LLM_PROTOCOL=openai_compatible 并填：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=

# ── 搜索 / 嵌入 ──
AIBID_SEARCH_BACKEND=dashscope
# remote=用远程嵌入接口（不需 568MB 本地模型）；local=本地 BGE-M3
EMBED_ENGINE=remote

# ── Multi-Agent ──
AIBID_AGENT=1
AIBID_COORDINATOR=1

# ── Neo4j 图库 ──
NEO4J_USER=neo4j
NEO4J_PASSWORD=请改成强密码
# ── 审核稳定性（2026-08 修复，见 docs/审核稳定性修复计划.md）──
# 孤儿任务守护：周期性对账滞留的 PENDING/PROCESSING 任务
# AUDIT_ORPHAN_ENABLED=true
# AUDIT_ORPHAN_SWEEP_INTERVAL_MS=60000
# AUDIT_ORPHAN_STALE_AFTER_MS=600000
