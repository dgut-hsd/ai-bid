{
  "openapi": "3.0.3",
  "info": {
    "title": "AI-Bid 多租户后端 API",
    "version": "tenant-v1",
    "description": "Java 业务网关的多租户认证、租户、成员、邀请和审核 SSE 契约。租户 ID 在 JSON、JWT、消息和 Header 中使用十进制字符串。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
