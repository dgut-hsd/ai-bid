          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Invitation"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/tenants/{tenantId}/invitations/{invitationId}": {
      "delete": {
        "operationId": "revokeInvitation",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/InvitationId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Empty"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/tenant-invitations/{token}/accept": {
      "post": {
        "operationId": "acceptInvitation",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InvitationToken"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Member"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/audit-tasks/{taskId}/stream": {
      "get": {
        "operationId": "streamAuditTask",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-Sent Events stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "id: 1002\nevent: progress\ndata: {\"schema_version\":1,\"event_id\":\"1002\",\"event\":\"progress\",\"tenant_id\":\"20001\",\"task_id\":\"task-01J9J2J8F0M7Y8B6J5G4T3R2Q1\",\"occurred_at\":\"2026-08-06T13:01:00.123Z\",\"data\":{\"stage\":\"legal\",\"percent\":42,\"message\":\"正在审查\"}}\n\n"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "TenantId": {
        "name": "tenantId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "InvitationId": {
        "name": "invitationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "InvitationToken": {
        "name": "token",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        }
      },
      "TaskId": {
        "name": "taskId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Size": {
        "name": "size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "required": [
          "code",
          "msg",
          "timestamp"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "msg": {
            "type": "string"
          },
          "data": {},
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorData": {
        "type": "object",
        "required": [
          "error_code",
          "request_id"
        ],
        "properties": {
          "error_code": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ErrorData"
              }
            }
          }
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "TenantRole": {
        "type": "string",
        "enum": [
          "OWNER",
          "ADMIN",
          "AUDITOR",
          "MEMBER",
          "VIEWER"
        ]
      },
      "TenantSummary": {
        "type": "object",
        "required": [
          "tenant_id",
          "tenant_code",
          "name",
          "status",
          "role",
          "permissions",
          "is_current"
        ],
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "tenant_code": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED",
              "DELETED"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/TenantRole"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_current": {
            "type": "boolean"
          }
        }
      },
      "Tenant": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TenantSummary"
          },
          {
            "type": "object",
            "required": [
              "owner_user_id",
              "plan_code",
              "version",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "owner_user_id": {
                "type": "string"
              },
              "plan_code": {
                "type": "string"
              },
              "settings": {
                "type": "object",
                "additionalProperties": true,
                "nullable": true
              },
              "version": {
                "type": "integer",
                "format": "int64"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "token",
          "token_type",
          "expires_in",
          "session_version",
          "user_info",
          "tenants"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "session_version": {
            "type": "integer",
            "format": "int64"
          },
          "user_info": {
            "type": "object",
            "required": [
              "user_id",
              "username"
            ],
            "properties": {
              "user_id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "real_name": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "current_tenant": {
            "$ref": "#/components/schemas/TenantSummary",
            "nullable": true
          },
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantSummary"
            }
          }
        }
      },
      "TenantMember": {
        "type": "object",
        "required": [
          "member_id",
          "tenant_id",
          "user_id",
          "role",
          "permissions",
          "status",
          "joined_at"
        ],
        "properties": {
          "member_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "real_name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/TenantRole"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "REMOVED"
            ]
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TenantInvitation": {
        "type": "object",
        "required": [
          "invitation_id",
          "tenant_id",
          "email",
          "role",
          "expires_at",
          "status"
        ],
        "properties": {
          "invitation_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/TenantRole"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "accept_token": {
            "type": "string",
            "writeOnly": true
          }
        }
